<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 只用它的图片解码（WEBP 背景图），界面仍是 WinForms -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>uutime</AssemblyName>
    <RootNamespace>UuTime</RootNamespace>
    <Version>1.3.3</Version>
    <Product>uutime</Product>
    <Description>应用使用时间</Description>
    <ApplicationIcon>uutime.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 界面全用代码写，不用设计器，不需要设计器序列化 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- 低占用：工作站 GC、关闭后台并发 GC、积极回收内存 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- 开了 UseWPF 后 SDK 不再默认引入这两个 -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘/窗口图标和标题栏头像 -->
    <EmbeddedResource Include="uutime.ico" LogicalName="uutime.ico" />
    <EmbeddedResource Include="avatar.png" LogicalName="avatar.png" />
  </ItemGroup>

</Project>
